{
    "exceptions":{
        "num_elements":{
            "min":5,
            "max":30,
            "ignore_elements":["H", "He", "C", "N", "O", "F", "Ne"]
        },
        "tc":{
            "non_sc_observed": true,
            "max": 50.0,
            "min": 0.0
        }
    },
    "keep_cols_from_dataset": [
        "hesc_id",
        "elements",
        "elements_fraction",
        "doi",
        "flags",
        "year",
        "material_class",
        "not_bulk",
        "repr_lattice",
        "line_compound",
        "species_partitioned",
        "process_dep_studied"
    ],
    "drop_cols_after_merge_duplicates":[
        "num_valid_tc"
    ],
    "duplicates_rule":{
        "tc": {
            "order": "highest",
            "sort_by": "max_Tc"
        },
        "criteria": "dataset",
        "rule_nan_compositions": "ignore",
        "merge_criteria":{
            "cityblock": 0.01,
            "smape": 0.02,
            "cross_elements_set": false
        },
        "log_columns":["year"],
        "cols_to_list":["hesc_id", "doi", "material_class", "not_bulk", "repr_lattice", "line_compound", "species_partitioned", "process_dep_studied"]
    },
    "dataset_config": "default.json",
    "hsd_exception_col": "exception_0803",
    "output_dir": "temp_devs/",
    "save_compositional5_pth": "compositional5_max_tc.csv",
    "save_log_pth": "compositional5_max_tc.log.json",
    "keep_original_index_as": "hesc_id",
    "keep_original_index_from": "hesc_id"
}